{
    "name": "ejsteste",
    "version": "1.0.0",
    "description": "Express.js + EJS web application",
    "main": "index.js",
    "scripts": {
        "start": "node server.js",
        "test": "jest --coverage --forceExit --detectOpenHandles",
        "test:watch": "jest --watch --coverage",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "format": "prettier --write \"**/*.{js,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{js,json,css,md}\"",
        "security:audit": "npm audit",
        "validate": "npm run lint && npm run test"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "ejs": "^2.5.6",
        "express": "^4.15.2"
    },
    "devDependencies": {
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.0",
        "supertest": "^6.3.4"
    },
    "jest": {
        "testEnvironment": "node",
        "collectCoverageFrom": [
            "index.js",
            "server.js"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 80,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        },
        "coverageReporters": [
            "lcov",
            "text",
            "clover"
        ]
    }
}
