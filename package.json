{
    "name": "ejsteste",
    "version": "1.0.0",
    "description": "Express.js + EJS web application (TypeScript + ESM)",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest --coverage --forceExit --detectOpenHandles",
        "test:watch": "jest --watch --coverage",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write \"**/*.{ts,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,json,css,md}\"",
        "security:audit": "npm audit",
        "validate": "npm run lint && npm run build && npm run test"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.6",
        "ejs": "^2.5.6",
        "express": "^4.21.2",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.0",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.0",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.2",
        "typescript": "^5.3.3"
    },
    "jest": {
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "testEnvironment": "node",
        "collectCoverageFrom": [
            "index.ts",
            "server.ts"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 55,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        },
        "coverageReporters": [
            "lcov",
            "text",
            "clover"
        ]
    }
}
